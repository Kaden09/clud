# Local service
SERVER_PORT="8084"

# PostgreSQL
SHARING_DATABASE_URL="jdbc:postgresql://localhost:5432/clud"
SHARING_DATABASE_USERNAME="clud"
SHARING_DATABASE_PASSWORD="clud"

# Internal services
FILE_SERVICE_URL="http://localhost:8082"
STORAGE_SERVICE_URL="http://localhost:8083"
SHARING_HTTP_CONNECT_TIMEOUT="2s"
SHARING_HTTP_READ_TIMEOUT="5s"
SHARING_STORAGE_HTTP_CONNECT_TIMEOUT="2s"
SHARING_STORAGE_HTTP_READ_TIMEOUT="30s"

# Public URL returned when a link is created locally
SHARING_PUBLIC_BASE_URL="http://localhost:8084/public"

# Kafka
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
FILE_EVENTS_TOPIC="file.events.v1"
SHARING_EVENTS_TOPIC="sharing.events.v1"
