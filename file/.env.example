# Local service
SERVER_PORT="8082"

# PostgreSQL
FILE_DATABASE_URL="jdbc:postgresql://localhost:5432/clud"
FILE_DATABASE_USERNAME="clud"
FILE_DATABASE_PASSWORD="clud"

# Storage service
STORAGE_SERVICE_URL="http://localhost:8083"
FILE_STORAGE_HTTP_CONNECT_TIMEOUT="2s"
FILE_STORAGE_HTTP_READ_TIMEOUT="30s"

# Kafka
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
FILE_EVENTS_TOPIC="file.events.v1"
