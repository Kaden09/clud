# Applications
# Host ports; replace with any free local port if a default is already in use.
NGINX_HOST_PORT=80
GATEWAY_HOST_PORT=8080
IDENTITY_HOST_PORT=8081
FILE_HOST_PORT=8082
STORAGE_HOST_PORT=8083
SHARING_HOST_PORT=8084

# Service addresses (Docker Compose network)
# Internal Compose URLs; use localhost:<host-port> when configuring a locally run service.
IDENTITY_SERVICE_URL="http://identity:8080"
FILE_SERVICE_URL="http://file:8080"
STORAGE_SERVICE_URL="http://storage:8080"
SHARING_SERVICE_URL="http://sharing:8080"

# Identity service
# SQL logging: false (quiet) or true (useful for local debugging).
IDENTITY_SHOW_SQL=false
# Kafka topic names; custom names are allowed when producers and consumers match.
IDENTITY_EVENTS_TOPIC="identity.events.v1"
# Base64-encoded secret of at least 32 bytes; generate a new value outside development.
JWT_SECRET=""
# Token lifetimes in milliseconds: 900000 = 15 min, 604800000 = 7 days.
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
# Comma-separated browser origins; e.g. https://app.example.com in production.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Use true with HTTPS in production; SameSite alternatives: Strict or None.
COOKIE_SECURE=false
COOKIE_SAME_SITE="Lax"
# Refresh-cookie scope; use / only when the cookie must be sent to the whole site.
COOKIE_PATH="/api/identity/auth"

# PostgreSQL
# Development credentials and database name; replace all three outside local use.
POSTGRES_USER="clud"
POSTGRES_PASSWORD="clud"
POSTGRES_DB="clud"
# Published host port; use another free port, such as 5433, on conflict.
POSTGRES_PORT=5432

# Redis
# Compose address. For a locally run app, use localhost and the published port.
REDIS_HOST="redis"
# Published host port; use another free port, such as 6380, on conflict.
REDIS_PORT=6379

# MinIO
# Internal S3-compatible endpoint; an external MinIO endpoint is also supported.
MINIO_URL="http://minio:9000"
# Development access credentials; replace both outside local use.
MINIO_ROOT_USER="minio"
MINIO_ROOT_PASSWORD="minioadmin"
# Published API and console ports; replace with free local ports on conflict.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# File service
# Kafka event topic; keep it identical in every producer and consumer.
FILE_EVENTS_TOPIC="file.events.v1"
# Spring duration format; alternatives include 500ms, 5s, or 1m.
FILE_STORAGE_HTTP_CONNECT_TIMEOUT="2s"
FILE_STORAGE_HTTP_READ_TIMEOUT="30s"

# Sharing service
# Public link prefix; replace with the externally reachable HTTPS URL in production.
SHARING_PUBLIC_BASE_URL="http://localhost/api/sharing/public"
# Spring duration format; alternatives include 500ms, 5s, or 1m.
SHARING_HTTP_CONNECT_TIMEOUT="2s"
SHARING_HTTP_READ_TIMEOUT="5s"
SHARING_STORAGE_HTTP_CONNECT_TIMEOUT="2s"
SHARING_STORAGE_HTTP_READ_TIMEOUT="30s"
# Kafka event topic; custom names are allowed when producers and consumers match.
SHARING_EVENTS_TOPIC="sharing.events.v1"

# Kafka
# Internal Compose broker; locally run apps normally use localhost:9092.
KAFKA_BOOTSTRAP_SERVERS="kafka:29092"
# Single-node defaults; change only when configuring a multi-node Kafka cluster.
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES="broker,controller"
# Published host port; use another free port, such as 9093, on conflict.
KAFKA_PORT=9092

# Observability
# Published host ports; replace any value with a free local port on conflict.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Development login; replace both values outside local use.
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"
# Additional published host ports; choose free local ports if needed.
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=12345
