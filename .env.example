# Applications
NGINX_PORT=80
GATEWAY_PORT=8080
IDENTITY_PORT=8081
FILE_PORT=8082
STORAGE_PORT=8083
SHARING_PORT=8084

# Gateway upstream services (Docker Compose network)
IDENTITY_SERVICE_URL=http://identity:8080
FILE_SERVICE_URL=http://file:8080
STORAGE_SERVICE_URL=http://storage:8080
SHARING_SERVICE_URL=http://sharing:8080

# Identity service
IDENTITY_SHOW_SQL=false
IDENTITY_EVENTS_TOPIC=identity.events.v1
JWT_SECRET=Y2x1ZC1kZXZlbG9wbWVudC1qd3Qtc2VjcmV0LTMyYiE=
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_PATH=/api/identity/auth

# PostgreSQL
POSTGRES_USER=clud
POSTGRES_PASSWORD=clud
POSTGRES_DB=clud
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_URL=http://minio:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# File service
FILE_EVENTS_TOPIC=file.events.v1

# Sharing service
SHARING_PUBLIC_BASE_URL=http://localhost/api/sharing/public
SHARING_HTTP_CONNECT_TIMEOUT=2s
SHARING_HTTP_READ_TIMEOUT=5s
SHARING_EVENTS_TOPIC=sharing.events.v1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_PORT=9092
