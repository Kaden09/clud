# Local service
SERVER_PORT="8082"

# PostgreSQL
DRIVE_DATABASE_URL="jdbc:postgresql://localhost:5432/clud"
DRIVE_DATABASE_USERNAME="clud"
DRIVE_DATABASE_PASSWORD="clud"

# Storage service
STORAGE_SERVICE_URL="http://localhost:8083"
DRIVE_STORAGE_HTTP_CONNECT_TIMEOUT="2s"
DRIVE_STORAGE_HTTP_READ_TIMEOUT="30s"

# Kafka
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
DRIVE_EVENTS_TOPIC="drive.events.v1"
