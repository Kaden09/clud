# Applications
NGINX_PORT=80
GATEWAY_PORT=8080
IDENTITY_PORT=8081
FILE_PORT=8082
STORAGE_PORT=8083
SHARING_PORT=8084

# Gateway upstream services (Docker Compose network)
IDENTITY_SERVICE_URL=http://identity:8080
FILE_SERVICE_URL=http://file:8080
STORAGE_SERVICE_URL=http://storage:8080
SHARING_SERVICE_URL=http://sharing:8080

# PostgreSQL
POSTGRES_USER=clud
POSTGRES_PASSWORD=clud
POSTGRES_DB=clud
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# File service
FILE_EVENTS_TOPIC=file.events.v1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_PORT=9092
