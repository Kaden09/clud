# Local service
# Local HTTP port; replace it with any free port if 8081 is already in use.
SERVER_PORT="8081"

# PostgreSQL
# JDBC URL and credentials used when Identity runs locally.
IDENTITY_DATABASE_URL="jdbc:postgresql://localhost:5432/clud"
IDENTITY_DATABASE_USERNAME="clud"
IDENTITY_DATABASE_PASSWORD="clud"
# Set to true only when SQL output is useful during local debugging.
IDENTITY_SHOW_SQL="false"

# Kafka
# Local broker address and topic used to publish Identity domain events.
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
IDENTITY_EVENTS_TOPIC="identity.events.v1"

# Authentication
# Base64-encoded secret of at least 32 bytes; use the same value in Gateway.
JWT_SECRET=""
# Stable issuer and intended API audience; both values must match Gateway.
JWT_ISSUER="clud-identity"
JWT_AUDIENCE="clud-api"
# Token lifetimes in milliseconds: 900000 = 15 minutes, 604800000 = 7 days.
JWT_ACCESS_TOKEN_EXPIRATION_MS="900000"
JWT_REFRESH_TOKEN_EXPIRATION_MS="604800000"
# Comma-separated browser origins allowed to call Identity through Gateway.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Keep false for local HTTP; enable it when refresh cookies are served over HTTPS.
COOKIE_SECURE="false"
# Refresh-cookie scope matching the public Identity auth route in Gateway.
COOKIE_PATH="/api/identity/auth"
