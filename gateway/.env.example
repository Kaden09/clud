# Local service
# Local HTTP port; replace it with any free port if 8080 is already in use.
SERVER_PORT="8080"

# Authentication
# Base64-encoded secret of at least 32 bytes; use the same value as Identity.
JWT_SECRET=""
# Must match the issuer and audience written by Identity.
JWT_ISSUER="clud-identity"
JWT_AUDIENCE="clud-api"
# Comma-separated browser origins; e.g. https://app.example.com in production.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Rate limiting
# Redis used for shared rate-limit counters when Gateway runs locally.
REDIS_HOST="localhost"
REDIS_PORT=6379

# Upstream HTTP
# Maximum wait between response reads; alternatives include 5s, 30s, or 1m.
GATEWAY_HTTP_READ_TIMEOUT="30s"
# Regex of direct proxy addresses whose Forwarded/X-Forwarded headers are trusted.
# The application default covers loopback and private Docker networks.
# GATEWAY_TRUSTED_PROXIES="127\.0\.0\.1"

# Downstream services
# Host URLs for locally run Gateway; adjust ports if services use non-default ones.
IDENTITY_SERVICE_URL="http://localhost:8081"
DRIVE_SERVICE_URL="http://localhost:8082"
SHARING_SERVICE_URL="http://localhost:8084"
